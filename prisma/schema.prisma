// Yozora — CLIENT, NOT A DATABASE (v2 architecture, see docs/CLIENT_ARCHITECTURE.md).
//
// This schema stores ONLY user-owned information:
//   users/sessions · extension configuration · library & favorites ·
//   collections · progress · history · reviews · reports · notifications ·
//   script installs.
//
// There is deliberately NO media catalog here: no Media/CatalogItem rows, no
// episode/chapter/page mirrors, no people/characters/tagdefs, no download
// queue, no sync log. Every work is referenced EXTERNALLY by
// (providerId, externalId) and fetched live from its provider at request time.
// Display snapshots (title/cover) are denormalized user bookmarks so the
// library renders without upstream calls — they are not a metadata database.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Users & sessions ───────────────────────────

model User {
  id            String    @id @default(cuid())
  username      String    @unique
  displayName   String?
  bio           String?
  avatarUrl     String?
  passwordHash  String
  ageVerifiedAt DateTime?
  isDemo        Boolean   @default(false)
  settings      String    @default("{}") // JSON: reader prefs, hidden categories…
  createdAt     DateTime  @default(now())

  sessions       Session[]
  library        LibraryEntry[]
  collections    Collection[]
  reviews        Review[]
  notifications  Notification[]
  history        HistoryEntry[]
  progress       Progress[]
  reports        Report[]
  scriptInstalls ScriptInstall[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─────────────────────── Extension configuration ───────────────────────
// One row per installed provider adapter. Holds ONLY the user's install
// decision, API keys and health status. The adapter definitions themselves
// live in src/lib/providers/{registry,live} — the database never stores
// catalog items.

model Provider {
  id            String    @id // slug, e.g. "mangadex" — matches PROVIDER_REGISTRY
  installed     Boolean   @default(true)
  config        String? // JSON: user config values (API keys etc.)
  status        String    @default("ACTIVE") // ACTIVE | ERROR | DISABLED
  lastError     String?
  lastCheckedAt DateTime?
  installedAt   DateTime  @default(now())
}

// ─────────────────────── Library (user-owned bookmarks) ───────────────────────
// Keyed by the EXTERNAL ref (providerId, externalId). titleSnapshot/coverSnapshot
// are display caches for offline rendering — bookmarks, not metadata.

model LibraryEntry {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId    String
  externalId    String
  category      String // ANIME | MANGA | MANHWA | ILLUSTRATION | AV | GAME | SCRIPT | MISC
  titleSnapshot String
  coverSnapshot String?
  status        String   @default("PLANNING") // PLANNING | IN_PROGRESS | COMPLETED | PAUSED | DROPPED
  progress      Float    @default(0) // latest chapter/episode number reached
  score         Int? // 0–10 personal score
  favorite      Boolean  @default(false)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, providerId, externalId])
  @@index([userId])
}

model Progress {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId    String
  externalId    String
  category      String
  kind          String // EPISODE | CHAPTER | GALLERY
  unitKey       String // provider-local unit key (e.g. "ep:3", "ch:12", "gallery")
  unitLabel     String?
  titleSnapshot String
  coverSnapshot String?
  positionSec   Int? // video position
  pageIndex     Int?
  completed     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, providerId, externalId, unitKey])
  @@index([userId, updatedAt])
}

model HistoryEntry {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId    String?
  externalId    String?
  category      String
  action        String // VIEW | READ | WATCH | BROWSE | SEARCH | INSTALL | PLAY
  detail        String?
  titleSnapshot String?
  coverSnapshot String?
  createdAt     DateTime @default(now())

  @@index([userId])
}

// ─────────────────────── Collections & reviews ───────────────────────

model Collection {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  items       CollectionItem[]

  @@index([userId])
}

model CollectionItem {
  id            String     @id @default(cuid())
  collectionId  String
  collection    Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  providerId    String
  externalId    String
  category      String
  titleSnapshot String
  coverSnapshot String?
  addedAt       DateTime   @default(now())

  @@unique([collectionId, providerId, externalId])
  @@index([collectionId])
}

model Review {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId    String
  externalId    String
  category      String
  titleSnapshot String?
  score         Int // 1–10
  title         String?
  body          String?
  createdAt     DateTime @default(now())

  @@unique([userId, providerId, externalId])
  @@index([providerId, externalId])
}

// ─────────────────────── Safety, notifications, installs ───────────────────────

model Report {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  targetType String // WORK | REVIEW | USER
  targetId   String // external ref "provider:externalId" or free-form
  reason     String
  details    String?
  status     String   @default("OPEN") // OPEN | REVIEWED | RESOLVED
  createdAt  DateTime @default(now())

  @@index([status])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   @default("INFO") // INFO | SUCCESS | WARNING | PROVIDER | LIBRARY
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model ScriptInstall {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId         String // "wotaku-scripts"
  externalId         String // external entry id in the upstream directory
  titleSnapshot      String
  enabled            Boolean  @default(true)
  grantedPermissions String   @default("[]")
  installedAt        DateTime @default(now())

  @@unique([userId, providerId, externalId])
}
